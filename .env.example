# Copy to .env for local dev, and add the same variables in Vercel:
# Project Settings → Environment Variables.
#
# NOTE: anything prefixed with VITE_ is bundled into the browser build and is
# therefore publicly visible. That is expected for these two values — a GA4
# measurement ID and a Formspree form URL are public identifiers by design and
# are safe to expose. Keeping them here means you can change them without
# editing source code. Never put a true secret (API key, password, private
# token) behind a VITE_ prefix.

# Google Analytics 4 measurement ID
VITE_GA4_ID=G-L798WTZ9CT

# Formspree form endpoint used by the quote form
VITE_FORMSPREE_URL=https://formspree.io/f/xjybkknv
